{
  "name": "vem-sa-vad-valspecial-2026",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "check:quotes": "node scripts/validate-quotes.mjs",
    "check:quote-links": "node scripts/check-quote-links.mjs",
    "check:quote-wording": "node scripts/check-riksdag-wording.mjs",
    "check:cloudflare:staging": "VEMSAVAD_CLOUDFLARE_STAGING=1 vinext-cloudflare deploy --config wrangler.jsonc --dry-run",
    "build:cloudflare:staging": "VEMSAVAD_CLOUDFLARE_STAGING=1 vinext build",
    "deploy:cloudflare:staging": "VEMSAVAD_CLOUDFLARE_STAGING=1 vinext-cloudflare deploy --config dist/server/wrangler.json",
    "rank:quotes": "node scripts/rank-quotes.mjs",
    "render:start-logos": "node scripts/render-start-stage-logos.mjs",
    "check": "npm run check:quotes && npm run lint && npm run build"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vinext/cloudflare": "1.0.0-beta.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
