{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vem sa vad? quote bank",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "theme", "party", "quote", "speaker", "speakerRole", "speakerTier", "speakerImage", "speakerCaricature", "date", "context", "source", "editorial", "verification", "reviewStatus"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
      "theme": { "enum": ["classic", "grodcircus", "aged-poorly", "disguise", "duel", "word-picture"] },
      "party": { "enum": ["S", "M", "SD", "V", "C", "KD", "L", "MP"] },
      "quote": { "type": "string", "minLength": 10 },
      "speaker": { "type": "string", "minLength": 1 },
      "speakerRole": { "type": "string", "minLength": 1 },
      "speakerTier": { "enum": ["party-leader", "prime-minister", "minister", "official-spokesperson"] },
      "speakerImage": {
        "type": ["string", "null"],
        "pattern": "^/leaders/[a-z0-9-]+\\.webp$"
      },
      "speakerCaricature": {
        "type": ["string", "null"],
        "pattern": "^/speaker-caricatures/[a-z0-9-]+\\.webp$"
      },
      "date": { "type": "string", "format": "date" },
      "context": { "type": "string", "minLength": 30 },
      "source": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "publisher", "url", "type"],
        "properties": {
          "title": { "type": "string" },
          "publisher": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "type": {
            "enum": [
              "riksdag-protocol",
              "official-speech",
              "official-party-page",
              "government-page",
              "official-audio-video",
              "public-service-recording",
              "secondary-lead"
            ]
          },
          "locator": { "type": "string" }
        }
      },
      "editorialNote": { "type": "string" },
      "aftermath": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "date", "headline", "summary", "source"],
        "properties": {
          "kind": { "enum": ["apology", "retraction", "policy-change", "later-contradiction"] },
          "date": { "type": "string", "format": "date" },
          "headline": { "type": "string", "minLength": 10 },
          "summary": { "type": "string", "minLength": 40 },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "publisher", "url", "type", "locator"],
            "properties": {
              "title": { "type": "string" },
              "publisher": { "type": "string" },
              "url": { "type": "string", "format": "uri" },
              "type": {
                "enum": [
                  "riksdag-protocol",
                  "official-speech",
                  "official-party-page",
                  "government-page",
                  "official-audio-video",
                  "public-service-recording"
                ]
              },
              "locator": { "type": "string", "minLength": 8 }
            }
          }
        }
      },
      "editorial": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tags", "riskFlags", "rationale", "scores"],
        "properties": {
          "tags": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": ["famous", "funny", "surprising", "misdirection", "historical", "current", "metaphor", "policy", "debate-reply"]
            }
          },
          "riskFlags": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": ["context-dependent", "commonly-misattributed", "sensitive", "translation", "clip-needed", "date-uncertain"]
            }
          },
          "rationale": { "type": "string", "minLength": 30 },
          "fameNote": { "type": "string", "minLength": 20 },
          "scores": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fame", "humor", "surprise", "misdirection", "relevance", "standaloneClarity", "sourceStrength"],
            "properties": {
              "fame": { "type": "integer", "minimum": 1, "maximum": 5 },
              "humor": { "type": "integer", "minimum": 1, "maximum": 5 },
              "surprise": { "type": "integer", "minimum": 1, "maximum": 5 },
              "misdirection": { "type": "integer", "minimum": 1, "maximum": 5 },
              "relevance": { "type": "integer", "minimum": 1, "maximum": 5 },
              "standaloneClarity": { "type": "integer", "minimum": 1, "maximum": 5 },
              "sourceStrength": { "type": "integer", "minimum": 1, "maximum": 5 }
            }
          }
        }
      },
      "verification": {
        "type": "object",
        "additionalProperties": false,
        "required": ["exactWording", "speakerIdentity", "date", "context", "primarySource", "lastChecked"],
        "properties": {
          "exactWording": { "type": "boolean" },
          "speakerIdentity": { "type": "boolean" },
          "date": { "type": "boolean" },
          "context": { "type": "boolean" },
          "primarySource": { "type": "boolean" },
          "lastChecked": { "type": ["string", "null"], "format": "date" }
        }
      },
      "reviewStatus": { "enum": ["candidate", "context-checked", "primary-source-checked", "approved", "rejected"] }
    }
  }
}
