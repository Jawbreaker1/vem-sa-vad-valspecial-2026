{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Who Said What POC quote bank",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "party", "quote", "speaker", "speakerRole", "date", "context", "source", "reviewStatus"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
      "party": { "enum": ["S", "M", "SD", "V", "C", "KD", "L", "MP"] },
      "quote": { "type": "string", "minLength": 10 },
      "speaker": { "type": "string", "minLength": 1 },
      "speakerRole": { "type": "string", "minLength": 1 },
      "speakerImage": { "type": ["string", "null"] },
      "date": { "type": "string", "format": "date" },
      "context": { "type": "string", "minLength": 30 },
      "source": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "publisher", "url"],
        "properties": {
          "title": { "type": "string" },
          "publisher": { "type": "string" },
          "url": { "type": "string", "format": "uri" }
        }
      },
      "editorialNote": { "type": "string" },
      "reviewStatus": { "enum": ["candidate", "context-checked", "primary-source-checked", "approved", "rejected"] }
    }
  }
}
